{# Easy Travel header: frosted bar that hides while scrolling down and returns on scroll up. #}
<header data-testid="store-header" class="store-header etx-header" id="etxHeader">
  <div class="lg:hidden">
    <salla-bullet-delivery-tag></salla-bullet-delivery-tag>
  </div>
  <div class="etx-container etx-header-inner">
    <div class="etx-header-start">
      <a data-testid="store-header-mobile-toggle" class="lg:hidden mburger mburger--collapse etx-icon-btn" href="#mobile-menu" aria-label="Open-menu">
        <i class="sicon-menu" aria-hidden="true"></i>
      </a>
      <a data-testid="store-header-logo" class="navbar-brand etx-brand" href="{{ store.url }}">
        <img fetchpriority="high" loading="eager" src="{{ (theme.settings.get('et_use_store_logo') and store.logo) ? store.logo|cdn(175) : 'images/logo.png'|asset }}" alt="{{ store.name }}">
        {% if is_page('index') %}
          <h1 class="sr-only">{{ store.name }}</h1>
        {% else %}
          <h2 class="sr-only">{{ store.name }}</h2>
        {% endif %}
      </a>
    </div>

    <nav class="etx-nav" aria-label="{{ trans('blocks.header.main_menu') }}">
      <custom-main-menu></custom-main-menu>
    </nav>

    <div class="etx-header-actions">
      {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
        <salla-localization-modal data-testid="store-header-localization" show-trigger></salla-localization-modal>
      {% endif %}
      {% if store.scope %}
        <button class="etx-icon-btn" type="button" aria-label="{{ store.scope.name }}" onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})"><i class="sicon-location" aria-hidden="true"></i></button>
      {% endif %}
      <button class="etx-icon-btn" type="button" data-testid="store-header-search" aria-label="{{ trans('common.elements.search') }}" onclick="salla.event.dispatch('search::open')"><i class="sicon-search" aria-hidden="true"></i></button>
      <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>
      <a class="etx-btn etx-btn-primary etx-btn-sm etx-header-cta" data-et-booking href="https://wa.me/{{ theme.settings.get('et_whatsapp', '966509890653') }}" target="_blank" rel="noopener">احجز رحلتك</a>
    </div>
  </div>
</header>
<div class="etx-header-space" aria-hidden="true"></div>
