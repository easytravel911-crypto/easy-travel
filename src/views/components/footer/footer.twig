{% set et_phone = theme.settings.get('et_phone', '0509890653') %}
{% set et_email = theme.settings.get('et_email', 'Easytravel.911@gmail.com') %}
{% set et_whatsapp = theme.settings.get('et_whatsapp', '966509890653') %}
{% set et_cr = theme.settings.get('et_cr', '7055183482') %}
{% set et_twitter = theme.settings.get('et_twitter', 'Easy_traveel') %}
{% set et_tiktok = theme.settings.get('et_tiktok', 'Easy_traveel') %}
{% set et_instagram = theme.settings.get('et_instagram', 'Easy.traveel') %}
<footer data-testid="store-footer" class="store-footer etx-site-footer">
	<div class="etx-footer-big" aria-hidden="true">رحلة بلا عناء</div>
	<div class="etx-container">
		<div class="etx-footer-grid">
			<div class="etx-footer-about">
				<a href="{{ link('/') }}" class="et-footer-logo etx-footer-logo">
					<img loading="lazy" src="{{ (theme.settings.get('et_use_store_logo') and store.logo) ? store.logo|cdn(175) : 'images/logo.png'|asset }}" alt="{{ store.name }}">
				</a>
				{% if store.description %}
					<div class="etx-footer-desc">{{ store.description|raw }}</div>
				{% else %}
					<p class="etx-footer-desc">نصمم رحلتك من البداية إلى النهاية: الطيران والفنادق والجولات والدعم طوال الطريق. أنت تستمتع، ونحن نهتم بالتفاصيل.</p>
				{% endif %}
				<div data-testid="store-footer-social" class="et-social etx-social">
					{% if et_twitter %}<a href="https://x.com/{{ et_twitter }}" target="_blank" rel="noopener" aria-label="X"><i class="sicon-twitter" aria-hidden="true"></i></a>{% endif %}
					{% if et_tiktok %}<a href="https://www.tiktok.com/@{{ et_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><i class="sicon-tiktok" aria-hidden="true"></i></a>{% endif %}
					{% if et_instagram %}<a href="https://www.instagram.com/{{ et_instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><i class="sicon-instagram" aria-hidden="true"></i></a>{% endif %}
				</div>
				<div class="etx-footer-badges">
					<salla-trust-badges data-testid="store-footer-trust-badges" dark></salla-trust-badges>
					{% if store.settings.tax.number %}
						<div class="etx-footer-tax">
							{% if store.settings.tax.certificate %}
								<a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/" alt="{{ store.settings.tax.number }}">
									<img width="40" height="50" src="{{'images/tax.png' | cdn(70,70)}}" loading="lazy" alt="value added tax">
								</a>
							{% endif %}
							<div>
								<small>{{ trans('common.elements.tax_number') }}</small>
								<b>{{ store.settings.tax.number }}</b>
							</div>
						</div>
						{% if store.settings.tax.certificate %}
							<salla-modal data-testid="store-footer-tax-modal" sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
								<div class="flex justify-center max-w-full">
									<img class="w-full" loading="lazy" data-src="{{ store.settings.tax.certificate }}" alt="{{ store.settings.tax.number }}"/>
								</div>
							</salla-modal>
						{% endif %}
					{% endif %}
				</div>
			</div>

			<div class="etx-footer-links">
				<h4>{{ trans('blocks.footer.pages_links') }}</h4>
				<salla-menu data-testid="store-footer-menu" source="footer" with-cookie-preferences></salla-menu>
			</div>

			<div data-testid="store-footer-contacts" class="et-footer-contacts etx-footer-contacts">
				<h4>{{ trans('blocks.footer.contact_us') }}</h4>
				<ul>
					<li><a href="https://wa.me/{{ et_whatsapp }}" target="_blank" rel="noopener"><i class="sicon-whatsapp" aria-hidden="true"></i><span dir="ltr">{{ et_phone }}</span></a></li>
					<li><a href="tel:{{ et_phone }}"><i class="sicon-phone" aria-hidden="true"></i><span dir="ltr">{{ et_phone }}</span></a></li>
					<li><a href="mailto:{{ et_email }}"><i class="sicon-mail" aria-hidden="true"></i><span dir="ltr">{{ et_email }}</span></a></li>
				</ul>
			</div>

			<div class="etx-footer-apps">
				<salla-apps-icons data-testid="store-footer-apps"></salla-apps-icons>
			</div>
		</div>

		<div class="etx-footer-bottom">
			<span class="copyright-text">{% hook copyright %}</span>
			{% if et_cr %}
				<span data-testid="store-footer-cr" class="et-footer-cr">{{ trans('blocks.footer.commercial_registration') }}: <b dir="ltr">{{ et_cr }}</b></span>
			{% endif %}
			<span class="etx-footer-tagline">العالم أقرب إليك ✈</span>
			<salla-payments data-testid="store-footer-payments"></salla-payments>
		</div>
	</div>
</footer>

{# Floating actions: WhatsApp on the right, back-to-top plane with scroll progress on the left. #}
<a class="etx-fab-wa" href="https://wa.me/{{ et_whatsapp }}" data-et-booking target="_blank" rel="noopener" aria-label="تواصل عبر واتساب"><i class="sicon-whatsapp" aria-hidden="true"></i></a>
<button class="etx-to-top" id="etxToTop" type="button" aria-label="العودة إلى الأعلى">
	<svg class="etx-ring" viewBox="0 0 58 58" aria-hidden="true"><circle class="etx-bg" cx="29" cy="29" r="26"/><circle class="etx-fg" id="etxToTopRing" cx="29" cy="29" r="26"/></svg>
	<svg class="etx-ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"/></svg>
</button>
